#! /usr/bin/vvp
:ivl_version "10.3 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "system";
:vpi_module "vhdl_sys";
:vpi_module "v2005_math";
:vpi_module "va_math";
S_0x55db4e6d51d0 .scope module, "d_latch" "d_latch" 2 1;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk"
    .port_info 1 /INPUT 1 "d"
    .port_info 2 /OUTPUT 1 "q"
o0x7f0518343018 .functor BUFZ 1, C4<z>; HiZ drive
v0x55db4e6d53e0_0 .net "clk", 0 0, o0x7f0518343018;  0 drivers
o0x7f0518343048 .functor BUFZ 1, C4<z>; HiZ drive
v0x55db4e717150_0 .net "d", 0 0, o0x7f0518343048;  0 drivers
v0x55db4e717210_0 .var "q", 0 0;
E_0x55db4e6d5900 .event edge, v0x55db4e717150_0, v0x55db4e6d53e0_0;
    .scope S_0x55db4e6d51d0;
T_0 ;
    %wait E_0x55db4e6d5900;
    %load/vec4 v0x55db4e6d53e0_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %load/vec4 v0x55db4e717150_0;
    %assign/vec4 v0x55db4e717210_0, 0;
T_0.0 ;
    %jmp T_0;
    .thread T_0, $push;
