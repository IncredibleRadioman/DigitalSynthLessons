#! /usr/bin/vvp
:ivl_version "10.3 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "system";
:vpi_module "vhdl_sys";
:vpi_module "v2005_math";
:vpi_module "va_math";
S_0x563f8d5141d0 .scope module, "d_flip_flop" "d_flip_flop" 2 1;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk"
    .port_info 1 /INPUT 1 "d"
    .port_info 2 /OUTPUT 1 "q"
o0x7f2a1a02b018 .functor BUFZ 1, C4<z>; HiZ drive
v0x563f8d5143e0_0 .net "clk", 0 0, o0x7f2a1a02b018;  0 drivers
o0x7f2a1a02b048 .functor BUFZ 1, C4<z>; HiZ drive
v0x563f8d555d60_0 .net "d", 0 0, o0x7f2a1a02b048;  0 drivers
v0x563f8d555e20_0 .var "q", 0 0;
E_0x563f8d514900 .event posedge, v0x563f8d5143e0_0;
    .scope S_0x563f8d5141d0;
T_0 ;
    %wait E_0x563f8d514900;
    %load/vec4 v0x563f8d555d60_0;
    %assign/vec4 v0x563f8d555e20_0, 0;
    %jmp T_0;
    .thread T_0;
