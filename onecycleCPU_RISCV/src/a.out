v0x557e0abb3220_0 .net "b", 31 0, o0x7f572d34c048;  0 drivers
v0x557e0abb3300_0 .net "y", 31 0, L_0x557e0abb3440;  1 drivers
L_0x557e0abb3440 .arith/sum 32, o0x7f572d34c018, o0x7f572d34c048;
